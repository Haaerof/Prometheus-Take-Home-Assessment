<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Integration tests: boot the real API in memory and drive it over HTTP.
    Microsoft.AspNetCore.Mvc.Testing supplies WebApplicationFactory, the
    equivalent of Spring's @SpringBootTest with MockMvc.
  -->

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- xUnit v3 test projects are executables: each one can run its own tests. -->
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\StockApp.Api\StockApp.Api.csproj" />
  </ItemGroup>

</Project>
