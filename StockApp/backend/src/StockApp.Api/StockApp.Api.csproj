<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Web host: controllers, dependency injection wiring, configuration, error handling. -->

  <PropertyGroup>
    <!--
      Lets the published app run on a newer installed runtime when .NET 8 is not present. Applied
      here rather than solution-wide: the integration tests must run on the runtime their TestHost
      package targets, since TestHost ships as a package and does not roll forward with the app.
    -->
    <RollForward>LatestMajor</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Swashbuckle.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\StockApp.Core\StockApp.Core.csproj" />
    <ProjectReference Include="..\StockApp.Infrastructure\StockApp.Infrastructure.csproj" />
  </ItemGroup>

</Project>
