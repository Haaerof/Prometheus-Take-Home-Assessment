<Project Sdk="Microsoft.NET.Sdk">

  <!-- Adapters to the outside world: implementations of the interfaces Core defines. -->

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" />
  </ItemGroup>

  <!--
    The adapter's types are internal so the vendor's shape cannot leak. The test assembly is
    granted access so those types can be tested directly rather than only through the web layer.
  -->
  <ItemGroup>
    <InternalsVisibleTo Include="StockApp.Infrastructure.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\StockApp.Core\StockApp.Core.csproj" />
  </ItemGroup>

</Project>
